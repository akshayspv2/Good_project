        <div class="container">
            <nav class="navbar">
                <a href="index.html" class="logo">Charge<span>Now</span></a>
                <ul class="nav-links">

                    <li><a href="login.html">Login</a></li>
                </ul>
            </nav>
        </div>
    </header>

    <!-- Main Content -->
    <main class="main-content">
        <div class="container">
            <div class="signup-container">
                <div class="signup-image">
                    <h2>Join ChargeNow</h2>
                    <p>Reserve charging stations with confidence and never wait in line again.</p>
                    
                    <div class="signup-benefits">
                        <ul>
                            <li>Easy station reservations</li>
                            <li>Real-time availability updates</li>
                            <!--<li>Preferred pricing for members</li>-->
                            <li>24/7 charging station access</li>
                            <li>Detailed charging history</li>
                            <!--<li>Mobile notifications</li>-->
                        </ul>
                    </div>
