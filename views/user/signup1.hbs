                                        <option value="other">Other</option>
                                    </select>
                                </div>
                            </div>
                        </div>-->
                        
                        <div class="checkbox-group">
                            <label class="checkbox-label">
                                <input type="checkbox" id="termsAgree" required>
                                I agree to the <a href="#">Terms of Service</a> and <a href="#">Privacy Policy</a>
                            </label>
                            <div class="error-message" id="termsError">You must agree to the terms</div>
                        </div>
                        
                        <!--<div class="checkbox-group">
                            <label class="checkbox-label">
                                <input type="checkbox" id="marketingAgree">
                                Keep me updated with news, special offers and exclusive promotions
                            </label>
                        </div>-->
                        
                        <div class="form-footer">
                            <button type="submit" class="btn btn-block">Create Account</button>
                            <p>Already have an account? <a href="/login">Log in</a></p>
                        </div>
                    </form>
                    
                    <!--<div class="social-signup">
                        <p>Or sign up with</p>
                        <div class="social-buttons">
                            <a href="#" class="social-btn">Google</a>
                            <a href="#" class="social-btn">Apple</a>
