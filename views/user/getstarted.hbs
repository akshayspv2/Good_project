                </div>-->
            </div>
        </div>
    </section>

    <!-- How It Works Section -->
    <section class="how-it-works" id="how-it-works">
        <div class="container">
            <div class="section-title">
                <h2>How It Works</h2>
                <p>Charging your EV has never been easier</p>
            </div>
            <div class="steps">
                <div class="step">
                    <div class="step-number">1</div>
                    <h3>Sign Up</h3>
                    <p>Create your ChargeNow account in minutes. Add your vehicle details and payment information.</p>
                </div>
                <div class="step">
                    <div class="step-number">2</div>
                    <h3>Find a Station</h3>
                    <p>Browse nearby charging stations and check real-time availability on our interactive map.</p>
                </div>
                <div class="step">
                    <div class="step-number">3</div>
                    <h3>Reserve</h3>
                    <p>Select your preferred time slot and reserve your charging station with one tap.</p>
                </div>
                <div class="step">
                    <div class="step-number">4</div>
                    <h3>Charge & Go</h3>
                    <p>Arrive at your reserved time, plug in your vehicle, and charge with confidence.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- CTA Section -->
    <section class="cta">
        <div class="container">
            <h2>Ready to Transform Your EV Charging Experience?</h2>
            <p>Join thousands of EV drivers who never worry about finding a charging station again. Get started with ChargeNow today!</p>
            <div class="cta-buttons">
                <a href="/signup" class="btn btn-white">Sign Up Now</a>
                <a href="#" class="btn btn-outlined">Learn More</a>
            </div>
        </div>
    </section>

