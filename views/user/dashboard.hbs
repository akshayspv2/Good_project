    const months = {{{json months}}};
  const kwhData = {{{json usage.monthlyKwh}}};
  const spendingData = {{{json usage.monthlySpending}}};

  // kWh Line Chart
  new Chart(document.getElementById("kwhChart"), {
    type: 'line',
    data: {
      labels: months,
      datasets: [{
        label: 'kWh Used',
        data: kwhData,
        borderColor: '#007bff',
        backgroundColor: 'rgba(0,123,255,0.1)',
        fill: true,
        tension: 0.3
      }]
    },
    options: {
      responsive: true,
      plugins: {
        legend: { position: 'top' },
        title: {
          display: true,
          text: 'Monthly Energy Consumption (kWh)'
        }
      }
    }
  });

  // ₹ Spending Bar Chart
  new Chart(document.getElementById("spendingChart"), {
    type: 'bar',
    data: {
      labels: months,
      datasets: [{
        label: '₹ Spent',
        data: spendingData,
        backgroundColor: '#28a745'
      }]
    },
    options: {
      responsive: true,
      plugins: {
        legend: { position: 'top' },
        title: {
          display: true,
          text: 'Monthly Spending (₹)'
        }
      }
    }
  });
</script>
