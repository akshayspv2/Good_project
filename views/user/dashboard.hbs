<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>User Dashboard</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="stylesheet" href="https://unpkg.com/leaflet/dist/leaflet.css" />
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    body {
      display: flex;
      background: #f4f6f9;
      color: #333;
      min-height: 100vh;
    }

    .sidebar {
  position: fixed;
  top: 0;
  left: 0;
  height: 100vh;
  width: 220px;
  background: #2c3e50;
  padding: 20px;
  color: white;
  display: flex;
  flex-direction: column;
  z-index: 1000;
}

    .sidebar h2 {
      margin-bottom: 30px;
      font-size: 24px;
      text-align: center;
    }

    .sidebar a {
      color: white;
      text-decoration: none;
      margin: 10px 0;
      padding: 10px;
      border-radius: 6px;
      transition: background 0.2s ease;
    }

    .sidebar a:hover {
      background: #34495e;
    }

   .main {
  margin-left: 220px; /* equal to sidebar width */
  flex-grow: 1;
  padding: 30px;
  overflow-y: auto;
}
    .main h1 {
      margin-bottom: 20px;
      font-size: 28px;
    }

    .stats-container {
      display: flex;
      gap: 20px;
      margin-bottom: 30px;
    }

    .stat-card {
      flex: 1;
      background: white;
      padding: 20px;
      border-radius: 12px;
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
      text-align: center;
    }

    .stat-card strong {
      display: block;
      font-size: 16px;
      color: #555;
      margin-bottom: 10px;
    }

    .stat-card p {
      font-size: 24px;
      font-weight: bold;
      color: #007bff;
    }

    .section {
      background: white;
      padding: 20px;
      border-radius: 12px;
      margin-bottom: 30px;
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
    }

    #map {
      height: 300px;
      border-radius: 10px;
      margin-bottom: 20px;
    }

    .station-list li {
      margin: 8px 0;
      padding: 8px;
      background: #f1f1f1;
      border-radius: 6px;
    }

    canvas {
      max-width: 100%;
      background: #fff;
      border-radius: 12px;
      padding: 10px;
    }

    ul {
      list-style-type: none;
      padding-left: 0;
    }

    a.btn {
      display: inline-block;
      background: #007bff;
      color: white;
      padding: 8px 14px;
      border-radius: 6px;
      text-decoration: none;
    }

    a.btn:hover {
      background: #0056b3;
    }

    .section h2 {
      font-size: 20px;
      margin-bottom: 15px;
    }

    @media (max-width: 768px) {
      .stats-container {
        flex-direction: column;
      }

      .sidebar {
        display: none;
      }

      body {
        flex-direction: column;
      }

      .main {
        padding: 20px;
      }
    }
  </style>
</head>

<body>
  <div class="sidebar">
    <h2>ChargeNow</h2>
    <a href="/dashboard">Dashboard</a>
    <a href="/stations">Find Stations</a>
    <a href="/reservation-history">My Reservations</a>
    <a href="/profile">Profile</a>
    <a href="/logout">Logout</a>
  </div>

  <div class="main">
    <h1>Welcome, {{user.name}}</h1>

    <!-- Stat Cards -->
    <div class="stats-container">
      <div class="stat-card">
        <strong>Active Reservations</strong>
        <p>{{reservations.act}}</p>
      </div>
      <div class="stat-card">
        <strong>Completed Charges</strong>
        <p>{{stats.completedCharges}}</p>
      </div>
      <div class="stat-card">
        <strong>Total Spent</strong>
        <p>₹{{stats.totalSpent}}</p>
      </div>
    </div>

    <!-- Nearby Stations -->
    <div class="section">
      <h2>Nearby Stations</h2>
      <div id="map"></div>
      <ul class="station-list" id="stationList"></ul>
    </div>

    <!-- Upcoming Reservations -->
    <div class="section">
      <h2>Upcoming Reservations</h2>
      {{#if reservations.upcoming.length}}
        <ul>
          {{#each reservations.upcoming}}
            <li>{{this.stationName}} on {{this.date}} at {{this.startTime}} to {{this.endTime}} </li>
          {{/each}}
        </ul>
      {{else}}
        <p>No upcoming reservations.</p>
      {{/if}}
    </div>

    <!-- Usage Summary --
    <div class="section">
      <h2>Usage Summary</h2>
      <p>Total kWh charged this month: {{usage.kwh}}</p>
      <p>Sessions this month: {{usage.sessions}}</p>
      <p>Total Spent: ₹{{usage.amount}}</p>
    </div>-->

