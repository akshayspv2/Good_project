 <script>
  const lat = 8.47031;
  const lng = 76.97971;
  const map = L.map('map').setView([lat, lng], 13);

  L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
    attribution: '© OpenStreetMap contributors'
  }).addTo(map);

  // Add marker for SCT College
  L.marker([lat, lng]).addTo(map)
    .bindPopup(`<strong>CHARGING STATIONS NEARBY</strong><br>Thiruvananthapuram`)
    .openPopup();

  // Add radius circle
  L.circle([lat, lng], {
    radius: 10000,
    color: '#007bff',
    fillColor: '#007bff',
    fillOpacity: 0.1
  }).addTo(map);

  // Fetch nearby stations relative to this fixed location
  (async () => {
    try {
      const res = await fetch('/nearby-stations', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ latitude: lat, longitude: lng, radius: 10 })
      });

      const stations = await res.json();
      const stationList = document.getElementById('stationList');
      stationList.innerHTML = '';

      if (stations.length === 0) {
        stationList.innerHTML = '<li>No stations found within 10km.</li>';
      }

      stations.forEach(station => {
        if (!station.coordinates || station.coordinates.length !== 2) return;

        const [stationLng, stationLat] = station.coordinates;
        const marker = L.marker([stationLat, stationLng]).addTo(map);
        marker.bindPopup(`
          <strong>${station.name}</strong><br>
          ${station.location}<br>
          ${station.distance?.toFixed(2)} km away<br>
          <a href="/stations/${station._id}" class="btn" style="margin-top:8px;">View Details</a>
        `);

        const li = document.createElement('li');
        li.innerHTML = `
          ${station.name} - ${station.distance?.toFixed(2)} km away
          <a href="/stations/${station._id}" style="margin-left:10px;color:#007bff;text-decoration:underline;">View Details</a>
        `;
        stationList.appendChild(li);
      });
    } catch (err) {
      console.error('Error fetching stations:', err);
      alert("Failed to fetch nearby stations.");
    }
  })();

