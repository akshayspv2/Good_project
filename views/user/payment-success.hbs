<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Payment Successful</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <style>
    body {
      background: #f7f9fc;
      display: flex;
      justify-content: center;
      align-items: center;
      height: 100vh;
      font-family: 'Segoe UI', sans-serif;
    }

    .success-box {
      background: white;
      text-align: center;
      padding: 40px 30px;
      border-radius: 16px;
      box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
    }

    .success-box img {
      width: 100px;
      margin-bottom: 20px;
    }

    h2 {
      color: #28a745;
      margin-bottom: 10px;
    }

    p {
      font-size: 16px;
      margin: 5px 0;
    }

    .code {
      font-size: 28px;
      font-weight: bold;
      color: #333;
      margin-top: 20px;
      background: #e9ecef;
      display: inline-block;
      padding: 10px 20px;
      border-radius: 8px;
      letter-spacing: 2px;
    }

    .btn {
      display: inline-block;
      margin-top: 30px;
      padding: 12px 24px;
      background-color: #007bff;
      color: white;
      text-decoration: none;
      border-radius: 8px;
      font-weight: bold;
      font-size: 15px;
      transition: background-color 0.3s;
    }

    .btn:hover {
      background-color: #0056b3;
    }
  </style>
</head>
<body>
  <div class="success-box">
    <img src="https://cdn-icons-png.flaticon.com/512/190/190411.png" alt="Success">
    <h2>Reservation Confirmed!</h2>
    <p>Your EV charging slot is reserved.</p>
    <p><strong>Date:</strong> {{date}}</p>
    <p><strong>Time:</strong> {{startTime}} - {{endTime}}</p>
    <div class="code">Code: {{code}}</div>

    <a href="/dashboard" class="btn">Go to Dashboard</a>
  </div>
</body>
</html>
