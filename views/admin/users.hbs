<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Manage Users - EV Admin</title>
  <style>
    body {
      font-family: 'Segoe UI', sans-serif;
      background: #f4f6f9;
      margin: 0;
      padding: 0;
      display: flex;
    }

    .sidebar {
      width: 220px;
      background-color: #2c3e50;
      color: white;
      height: 100vh;
      padding: 20px;
      box-sizing: border-box;
    }

    .sidebar h1 {
      font-size: 20px;
      margin-bottom: 30px;
      text-align: center;
    }

    .sidebar a {
      color: white;
      text-decoration: none;
      display: block;
      padding: 10px;
      margin-bottom: 10px;
      border-radius: 6px;
      transition: background 0.2s;
    }

    .sidebar a:hover {
      background-color: #34495e;
    }

    .main {
      flex: 1;
      padding: 40px;
    }

    .main h2 {
      margin-bottom: 20px;
      color: #2c3e50;
    }

    .search-bar {
      margin-bottom: 20px;
    }

    .search-bar input {
      padding: 10px;
      font-size: 16px;
      width: 300px;
      border-radius: 6px;
      border: 1px solid #ccc;
    }

    table {
      width: 100%;
      border-collapse: collapse;
      background: white;
      box-shadow: 0 2px 5px rgba(0,0,0,0.05);
      border-radius: 8px;
      overflow: hidden;
    }

    th, td {
      padding: 12px 16px;
      border-bottom: 1px solid #ddd;
      text-align: left;
    }

    th {
      background: #2c3e50;
      color: white;
    }

    tr:hover {
      background-color: #f1f1f1;
    }

    .action-btn {
      padding: 6px 12px;
      border: none;
      border-radius: 6px;
      cursor: pointer;
      font-size: 14px;
    }

    .block-btn {
      background-color: #e74c3c;
      color: white;
    }

    .unblock-btn {
      background-color: #2ecc71;
      color: white;
    }
  </style>
</head>
<body>

  <div class="sidebar">
    <h1>EV Admin</h1>
    <a href="/admin/adminDashboard">Dashboard</a>
    <a href="/admin/add-station">Add Station</a>
    <a href="/admin/station">Stations</a>
    <a href="/admin/users">Users</a>
    <a href="/admin/reservations">Reservations</a>
    <a href="/admin/logout">Logout</a>
  </div>

  <div class="main">
    <h2>Manage Users</h2>

    <form class="search-bar" id="searchForm" action="/admin/users" method="GET">
  <input type="text" placeholder="Search users by name or email..." id="userSearch" name="query" >
  <button type="submit" class="action-btn" style="margin-left: 10px; background-color: #3498db; color: white;">Search</button>
</form>

    <table>
      <thead>
        <tr>
          <th>Name</th>
          <th>Email</th>
          <th>Status</th>
          <th>Action</th>
        </tr>
      </thead>
      <tbody id="userTable">
        {{#each users}}
        <tr>
          <td>{{this.name}}</td>
          <td>{{this.email}}</td>
          <td>{{this.status}}</td>
          <td>
            <form action="/admin/toggle-user-status/{{this._id}}" method="POST">
              {{#if (eq this.status "active")}}
                <button type="submit" class="action-btn block-btn">Block</button>
              {{else}}
                <button type="submit" class="action-btn unblock-btn">Unblock</button>
              {{/if}}
            </form>
            <form action="/admin/delete-user/{{this._id}}" method="POST" style="display:inline;" onsubmit="return confirm('Are you sure you want to delete this user?');">
                <button type="submit" class="action-btn block-btn" style="background-color: #555;">Delete</button>
             </form>
          </td>
        </tr>
        {{/each}}
      </tbody>
    </table>
  </div>

</body>
</html>
