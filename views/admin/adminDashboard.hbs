<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Admin Dashboard - EV System</title>
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: 'Segoe UI', sans-serif;
      background: #f4f6f9;
      display: flex;
      height: 100vh;
      overflow: hidden;
    }

    .sidebar {
      width: 220px;
      background-color: #2c3e50;
      color: white;
      display: flex;
      flex-direction: column;
      padding: 20px;
    }

    .sidebar h1 {
      font-size: 20px;
      margin-bottom: 30px;
      text-align: center;
    }

    .sidebar a {
      color: white;
      text-decoration: none;
      margin: 10px 0;
      padding: 10px;
      border-radius: 6px;
      display: block;
      transition: background 0.2s ease;
    }

    .sidebar a:hover {
      background-color: #34495e;
    }

    .main {
      flex: 1;
      padding: 30px;
      overflow-y: auto;
    }

    .cards {
      display: flex;
      gap: 20px;
      margin-bottom: 30px;
    }

    .card {
      flex: 1;
      background: white;
      padding: 25px;
      border-radius: 12px;
      box-shadow: 0 3px 6px rgba(0, 0, 0, 0.05);
      text-align: center;
    }

    .card h3 {
      margin-bottom: 10px;
      color: #333;
    }

    .card p {
      font-size: 24px;
      font-weight: bold;
      color: #007bff;
    }

    .charts {
      display: flex;
      gap: 30px;
      flex-wrap: wrap;
    }

    .chart-container {
      flex: 1;
      min-width: 300px;
      height: 300px;
      background: white;
      padding: 20px;
      border-radius: 12px;
      box-shadow: 0 3px 6px rgba(0, 0, 0, 0.05);
    }

    .chart-container h3 {
      text-align: center;
      margin-bottom: 15px;
    }

    table {
      width: 100%;
      border-collapse: collapse;
      background: white;
      box-shadow: 0 3px 6px rgba(0,0,0,0.05);
      border-radius: 12px;
      overflow: hidden;
    }

    th, td {
      padding: 12px;
      text-align: center;
      border-bottom: 1px solid #eee;
    }

    th {
      background-color: #007bff;
      color: white;
    }

    .reservation-table th {
      background-color: #1cc88a;
    }

    footer {
      text-align: center;
      padding: 15px;
      color: #999;
      font-size: 14px;
    }
  </style>
</head>
<body>

  <div class="sidebar">
    <h1>EV Admin</h1>
    <a href="/admin/adminDashboard">Dashboard</a>
    <a href="/admin/add-station">Add Stations</a>
    <a href="/admin/station">Stations</a>
    <a href="/admin/users">Users</a>
    <a href="/admin/reservations">Reservations</a>
    <a href="/admin/logout">Logout</a>
  </div>

  <div class="main">
    <!-- Total Cards -->
    <section class="cards">
      <div class="card">
        <h3>Total Users</h3>
        <p>{{totalUsers}}</p>
      </div>
      <div class="card">
        <h3>Total Stations</h3>
        <p>{{totalStations}}</p>
      </div>
      <div class="card">
        <h3>Total Reservations</h3>
        <p>{{totalReservations}}</p>
      </div>
    </section>

    <!-- Charts -->
    <section class="charts">
      <div class="chart-container">
        <h3>User Growth</h3>
        <canvas id="userChart"></canvas>
      </div>

      <div class="chart-container">
        <h3>Reservations Over Time</h3>
        <canvas id="reservationChart"></canvas>
      </div>
    </section>

    <!-- Last 10 Users -->
    <section style="margin-top: 40px;">
      <div style="margin-bottom: 30px;">
        <h3 style="margin-bottom: 15px;">Last 10 Users</h3>
        <table>
          <thead>
            <tr>
              <th>Name</th>
              <th>Email</th>
              <th>Signup Date</th>
            </tr>
          </thead>
          <tbody>
            {{#each recentUsers}}
              <tr>
                <td>{{this.name}}</td>
                <td>{{this.email}}</td>
                <td>{{this.date}}</td>
              </tr>
            {{/each}}
          </tbody>
        </table>
      </div>

      <!-- Last 10 Reservations -->
      <div>
        <h3 style="margin-bottom: 15px;">Last 10 Reservations</h3>
        <table class="reservation-table">
          <thead>
            <tr>
              <th>User</th>
              <th>Station</th>
              <th>Date</th>
            </tr>
          </thead>
          <tbody>
            {{#each recentReservations}}
              <tr>
                <td>{{this.userName}}</td>
                <td>{{this.stationName}}</td>
                <td>{{this.date}}</td>
              </tr>
            {{/each}}
          </tbody>
        </table>
      </div>
    </section>

    <footer style="margin-top: 40px;">&copy; 2025 EV Charging Reservation System</footer>
  </div>

  <script>
    const userChart = new Chart(document.getElementById('userChart'), {
      type: 'line',
      data: {
        labels: {{{userChartLabels}}},
        datasets: [{
          label: 'Users',
          data: {{{userChartData}}},
          borderColor: '#4e73df',
          backgroundColor: 'rgba(78, 115, 223, 0.1)',
          fill: true,
          tension: 0.3
        }]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false
      }
    });

    const reservationChart = new Chart(document.getElementById('reservationChart'), {
      type: 'bar',
      data: {
        labels: {{{reservationChartLabels}}},
        datasets: [{
          label: 'Reservations',
          data: {{{reservationChartData}}},
          backgroundColor: '#1cc88a'
        }]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false
      }
    });
  </script>

</body>
</html>