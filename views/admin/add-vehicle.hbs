<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Add Vehicle</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
  <style>
    body {
      background: #f8f9fa;
      padding: 40px;
    }
    .card {
      max-width: 600px;
      margin: auto;
      border-radius: 12px;
      box-shadow: 0 5px 15px rgba(0,0,0,0.1);
    }
    .form-label {
      font-weight: 500;
    }
  </style>
</head>
<body>
  <div class="card p-4">
    <h3 class="text-center mb-4">Add New Vehicle</h3>
    <form action="/admin/add-vehicle" method="POST">
      <div class="mb-3">
        <label for="company" class="form-label">Vehicle Company</label>
        <input type="text" id="company" name="company" class="form-control" required placeholder="e.g., Tesla, Tata, Hyundai">
      </div>
      <div class="mb-3">
        <label for="model" class="form-label">Vehicle Model</label>
        <input type="text" id="model" name="model" class="form-control" required placeholder="e.g., Model 3, Nexon EV, Kona Electric">
      </div>
      <div class="mb-3">
        <label for="capacity" class="form-label">Battery Capacity (kWh)</label>
        <input type="number" id="capacity" name="capacity" class="form-control" step="0.1" min="1" required placeholder="e.g., 50">
      </div>
      <div class="d-grid">
        <button type="submit" class="btn btn-primary">Add Vehicle</button>
      </div>
    </form>
  </div>
</body>
</html>
